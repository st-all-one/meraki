{
  "name": "meraki",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --env-file=../.env --watch --allow-net --allow-env --allow-read --allow-write --allow-sys=hostname,networkInterfaces src/main.ts",
    "start": "deno run --env-file=../.env --allow-net --allow-env --allow-read --allow-write --allow-sys=hostname,networkInterfaces src/main.ts",
    "migrate": "deno run --env-file=../.env --allow-read --allow-write --allow-env --allow-net src/main.ts migrate",
    "seed": "deno run --env-file=../.env --allow-read --allow-write --allow-env --allow-net src/main.ts seed",
    "backup": "deno run --env-file=../.env --allow-read --allow-write --allow-env src/main.ts backup",
    "restore": "deno run --env-file=../.env --allow-read --allow-write --allow-env src/main.ts restore",
    "doctor": "deno run --env-file=../.env --allow-read --allow-write --allow-env src/main.ts doctor",
    "create-admin": "deno run --env-file=../.env --allow-read --allow-write --allow-env src/main.ts create-admin",
    "push:keys": "deno run --allow-net --allow-env --allow-read --allow-write src/main.ts push:keys",
    "whiteboard:build": "deno run --allow-read --allow-write --allow-run --allow-env scripts/build-whiteboard.ts",
    "test": "MERAKI_TEST=1 deno test --env-file=../.env --allow-net --allow-env --allow-read --allow-write --allow-sys=hostname,networkInterfaces tests/",
    "check": "deno fmt --check && deno lint && deno check src scripts tests && deno run --allow-read --allow-env scripts/gates.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "build:bin": "deno task whiteboard:build && deno compile --allow-net --allow-env --allow-read --allow-write --allow-sys=hostname,networkInterfaces --include src --include static --output dist/meraki src/main.ts",
    "build:bin:linux": "deno task whiteboard:build && deno compile --allow-net --allow-env --allow-read --allow-write --allow-sys=hostname,networkInterfaces --include src --include static --target x86_64-unknown-linux-gnu --output dist/meraki-linux-x64 src/main.ts",
    "e2e": "cd e2e && npm test",
    "ci": "deno task check && deno task test"
  },
  "imports": {
    "@/": "./src/",
    "@kernel/": "./src/kernel/",
    "@services/": "./src/services/",
    "@modules/": "./src/modules/",
    "@layout/": "./src/layout/",
    "hono": "npm:hono@4.13.13",
    "hono/cookie": "npm:hono@4.13.13/cookie",
    "hono/csrf": "npm:hono@4.13.13/csrf",
    "hono/deno": "npm:hono@4.13.13/deno",
    "hono/http-exception": "npm:hono@4.13.13/http-exception",
    "hono/jsx": "npm:hono@4.13.13/jsx",
    "hono/streaming": "npm:hono@4.13.13/streaming",
    "@noble/hashes/argon2": "jsr:@noble/hashes@^2.4.0/argon2.js",
    "@noble/hashes/blake3": "jsr:@noble/hashes@^2.4.0/blake3.js",
    "@noble/hashes/utils": "jsr:@noble/hashes@^2.4.0/utils.js",
    "markdown-it": "npm:markdown-it@14.1.0",
    "@excalidraw/excalidraw": "npm:@excalidraw/excalidraw@0.18.0",
    "react": "npm:react@18.3.1",
    "react-dom/client": "npm:react-dom@18.3.1/client",
    "react-dom": "npm:react-dom@18.3.1",
    "web-push": "npm:web-push@3.6.7",
    "@types/web-push": "npm:@types/web-push@3.6.4",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "useUnknownInCatchVariables": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx",
    "jsxPrecompileSkipElements": ["script", "style"]
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": ["static/", "docs/", "e2e/"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "eqeqeq",
        "no-eval",
        "no-explicit-any",
        "no-throw-literal",
        "no-self-compare",
        "no-constant-condition",
        "no-inferrable-types",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-useless-rename",
        "single-var-declarator",
        "triple-slash-reference"
      ]
    },
    "exclude": ["static/"]
  }
}
