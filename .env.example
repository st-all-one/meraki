# Meraki — único ponto de configuração (Docker e host).
# Copie para .env; nunca versione o .env real.
# Desenvolvimento: make dev  |  Produção: make prod

# --- URLs / borda -----------------------------------------------------------
# Dev: Caddy em localhost:50380. Produção: URL pública atrás do LB/TLS.
DEV_APP_URL=http://localhost:50380
PROD_APP_URL=https://meraki.example.com
EDGE_BIND=127.0.0.1
EDGE_PORT=50380

# --- Aplicação --------------------------------------------------------------
APP_NAME=Meraki
HOST=0.0.0.0
PORT=50300
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Caminhos relativos ao WORKDIR /app dentro do container (e a app/ no host).
DATA_PATH=./data
DB_PATH=./data/meraki.sqlite3
HOST_DATA_PATH=./data
DB_BUSY_TIMEOUT_MS=5000

# Migra no boot do container; em produção faça backup antes de atualizar.
AUTO_MIGRATE=true
SEED_ON_BOOT=true

SESSION_COOKIE=meraki_session
SESSION_TTL_SECONDS=604800

SEED_EMAIL=admin@meraki.local
SEED_PASSWORD=troque-esta-senha

RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=3
MAX_CHAT_BODY=10000

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@meraki.local
